# Optional. Lets Trust Wallet on a phone pair with a QR if the extension is not installed.
# Create a project at https://cloud.reown.com and add http://localhost:3000
# to the allowed origins. MetaMask, Core, and the Trust extension work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Kredoof API origin (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8471

# Cookie signing for login sessions (32+ characters).
SESSION_SECRET=

# Public treasury address (on-chain). Private key is server-only — never commit it.
NEXT_PUBLIC_TREASURY_ADDRESS=0xF48AFA3d8443752630B6BB9cFEA5fA68199402f7
TREASURY_PRIVATE_KEY=

# Site origin used in registration emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (server-only).
RESEND_API_KEY=
EMAIL_FROM=Kredoof <noreply@kredoof.com>
EMAIL_CONFIRM_REQUIRED=

# Vercel Blob (set automatically when a Blob store is linked). Survives serverless cold starts.
BLOB_READ_WRITE_TOKEN=

# Google sign-in (server-only client secret). Redirects must match this app origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres. When set, accounts and loans use the database.
DATABASE_URL=

