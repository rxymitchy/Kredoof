# Optional. Required only for WalletConnect / mobile QR pairing.
# Create a project at https://cloud.reown.com and add http://localhost:3000
# to the allowed origins. MetaMask, Coinbase Wallet, and Rabby work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Kredoof API. Leave empty to keep the built-in mock profile.
# Local: http://127.0.0.1:8471
# After you host the API (Render), use that https URL and rebuild the frontend.
NEXT_PUBLIC_API_URL=
