# Optional. Required only for WalletConnect / mobile QR pairing.
# Create a project at https://cloud.reown.com and add http://localhost:3000
# to the allowed origins. MetaMask, Coinbase Wallet, and Rabby work without this.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Kredoof API origin (no trailing slash).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8471

# Cookie signing for login sessions (32+ characters).
SESSION_SECRET=

# Avalanche C-Chain USDC treasury (public address is safe to share).
NEXT_PUBLIC_TREASURY_ADDRESS=0xF48AFA3d8443752630B6BB9cFEA5fA68199402f7
# Hex private key for that treasury. Never commit this. Required to draw.
TREASURY_PRIVATE_KEY=

# Site origin used in registration emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API key. Required to send the signup confirmation email.
# https://resend.com — until this is set, users still sign in with password.
RESEND_API_KEY=
EMAIL_FROM=Kredoof <onboarding@resend.dev>

# Vercel Blob (set automatically when a Blob store is linked). Survives serverless cold starts.
BLOB_READ_WRITE_TOKEN=
